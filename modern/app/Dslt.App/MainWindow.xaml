<Window x:Class="Dslt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Dslt.App.Infrastructure"
        Title="DSLT Workbench" Width="1500" Height="920" MinWidth="900" MinHeight="500"
        Background="#0B1016" Foreground="#EEF3F8" FontFamily="Segoe UI">
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Command="{Binding SaveSourceViewsCommand}" />
    <KeyBinding Key="D" Command="{Binding SaveResultViewsCommand}" />
    <KeyBinding Key="J" Modifiers="Alt" Command="{Binding MergeSelectionCommand}" />
    <KeyBinding Key="S" Modifiers="Alt" Command="{Binding SplitSelectionCommand}" />
    <KeyBinding Key="A" Modifiers="Alt" Command="{Binding SelectAllCommand}" />
    <KeyBinding Key="D" Modifiers="Alt" Command="{Binding ClearSelectionCommand}" />
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoEditCommand}" />
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
      <RowDefinition Height="44" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="#283241" BorderThickness="0,0,0,1">
      <Grid Margin="22,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="34" Height="34" Background="{StaticResource AccentBrush}" CornerRadius="8">
            <TextBlock Text="D" Foreground="#08110F" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0">
            <TextBlock Text="DSLT Workbench" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Open → inspect → process → segment → edit → export" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding BackendSummary}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="235" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="#283241" BorderThickness="0,0,1,0">
        <ScrollViewer AutomationProperties.Name="Navigation and volume controls" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="18,20">
            <TextBlock Text="WORKFLOW" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10" />
            <ListBox AutomationProperties.Name="Workflow stage" ItemsSource="{Binding WorkflowStages}" SelectedItem="{Binding SelectedStage}" Background="Transparent" BorderThickness="0" />
            <Separator Margin="0,12" Background="#283241" />
            <Button Content="Open TIFF / LSM" Command="{Binding OpenCommand}" HorizontalContentAlignment="Left" />
            <Button AutomationProperties.Name="Load segment TIFF" Content="Load segment TIFF" Command="{Binding LoadSegmentsCommand}" HorizontalContentAlignment="Left" Background="#39475A" Foreground="White" />
            <Button AutomationProperties.Name="Save source orthogonal TIFF views" Content="Save source XY / YZ / ZX" Command="{Binding SaveSourceViewsCommand}" HorizontalContentAlignment="Left" Background="#39475A" Foreground="White" />
            <Button AutomationProperties.Name="Save result orthogonal TIFF views" Content="Save result XY / YZ / ZX" Command="{Binding SaveResultViewsCommand}" HorizontalContentAlignment="Left" Background="#39475A" Foreground="White" />
            <Button Content="Generate synthetic" Command="{Binding GenerateSyntheticCommand}" HorizontalContentAlignment="Left" Background="#39475A" Foreground="White" />
            <TextBlock Text="CHANNEL" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,5" />
            <ComboBox AutomationProperties.Name="Channel selector" ItemsSource="{Binding ChannelLabels}" SelectedIndex="{Binding ChannelIndex}" />
            <TextBlock Text="X COORDINATE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,5" />
            <Slider AutomationProperties.Name="X coordinate" Minimum="0" Maximum="{Binding MaximumXIndex}" Value="{Binding XIndex}" TickFrequency="1" IsSnapToTickEnabled="True" />
            <TextBlock Text="{Binding XIndex, StringFormat=X {0}}" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Y COORDINATE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,5" />
            <Slider AutomationProperties.Name="Y coordinate" Minimum="0" Maximum="{Binding MaximumYIndex}" Value="{Binding YIndex}" TickFrequency="1" IsSnapToTickEnabled="True" />
            <TextBlock Text="{Binding YIndex, StringFormat=Y {0}}" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Z SLICE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,5" />
            <Slider AutomationProperties.Name="Z slice" Minimum="0" Maximum="{Binding MaximumZIndex}" Value="{Binding ZIndex}" TickFrequency="1" IsSnapToTickEnabled="True" />
            <TextBlock Text="{Binding ZIndex, StringFormat=Slice {0}}" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="SHARED ZOOM" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,5" />
            <Slider AutomationProperties.Name="Shared zoom" Minimum="0.25" Maximum="8" Value="{Binding Zoom}" SmallChange="0.25" />
            <TextBlock Text="{Binding Zoom, StringFormat={}{0:F2}x}" Foreground="{StaticResource AccentBrush}" />
            <Separator Margin="0,14,0,12" Background="#283241" />
            <TextBlock Text="VOLUME" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Text="{Binding VolumeSummary}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1" Margin="18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Synchronized orthogonal workspace" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,12" />
        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Margin="0,0,5,5" Background="#05080C" BorderBrush="#2D3949" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <Grid>
              <TextBlock Text="SOURCE XY" Foreground="{StaticResource MutedBrush}" Margin="9" Panel.ZIndex="1" />
              <ScrollViewer AutomationProperties.Name="Source XY view" infra:ScrollSyncBehavior.Group="OrthogonalViews" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="16">
                <Image Source="{Binding SourceImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" infra:LegacyImageInteractionBehavior.IsEnabled="True" infra:LegacyImageInteractionBehavior.Plane="Xy">
                  <Image.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" /></Image.LayoutTransform>
                </Image>
              </ScrollViewer>
            </Grid>
          </Border>
          <Border Grid.Column="1" Margin="5,0,5,5" Background="#05080C" BorderBrush="#2D3949" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <Grid>
              <TextBlock Text="SOURCE YZ" Foreground="{StaticResource MutedBrush}" Margin="9" Panel.ZIndex="1" />
              <ScrollViewer AutomationProperties.Name="Source YZ view" infra:ScrollSyncBehavior.Group="OrthogonalViews" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="16">
                <Image Source="{Binding SourceYzImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" infra:LegacyImageInteractionBehavior.IsEnabled="True" infra:LegacyImageInteractionBehavior.Plane="Yz">
                  <Image.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" /></Image.LayoutTransform>
                </Image>
              </ScrollViewer>
            </Grid>
          </Border>
          <Border Grid.Column="2" Margin="5,0,0,5" Background="#05080C" BorderBrush="#2D3949" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <Grid>
              <TextBlock Text="SOURCE ZX" Foreground="{StaticResource MutedBrush}" Margin="9" Panel.ZIndex="1" />
              <ScrollViewer AutomationProperties.Name="Source ZX view" infra:ScrollSyncBehavior.Group="OrthogonalViews" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="16">
                <Image Source="{Binding SourceZxImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" infra:LegacyImageInteractionBehavior.IsEnabled="True" infra:LegacyImageInteractionBehavior.Plane="Zx">
                  <Image.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" /></Image.LayoutTransform>
                </Image>
              </ScrollViewer>
            </Grid>
          </Border>
          <Border Grid.Row="1" Margin="0,5,5,0" Background="#05080C" BorderBrush="#2D3949" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <Grid>
              <TextBlock Text="RESULT XY" Foreground="{StaticResource MutedBrush}" Margin="9" Panel.ZIndex="1" />
              <ScrollViewer AutomationProperties.Name="Result XY view" infra:ScrollSyncBehavior.Group="OrthogonalViews" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="16">
                <Image Source="{Binding ResultImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" infra:LegacyImageInteractionBehavior.IsEnabled="True" infra:LegacyImageInteractionBehavior.Plane="Xy" infra:LegacyImageInteractionBehavior.SelectLabels="True">
                  <Image.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" /></Image.LayoutTransform>
                </Image>
              </ScrollViewer>
            </Grid>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Margin="5,5,5,0" Background="#05080C" BorderBrush="#2D3949" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <Grid>
              <TextBlock Text="RESULT YZ" Foreground="{StaticResource MutedBrush}" Margin="9" Panel.ZIndex="1" />
              <ScrollViewer AutomationProperties.Name="Result YZ view" infra:ScrollSyncBehavior.Group="OrthogonalViews" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="16">
                <Image Source="{Binding ResultYzImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" infra:LegacyImageInteractionBehavior.IsEnabled="True" infra:LegacyImageInteractionBehavior.Plane="Yz" infra:LegacyImageInteractionBehavior.SelectLabels="True">
                  <Image.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" /></Image.LayoutTransform>
                </Image>
              </ScrollViewer>
            </Grid>
          </Border>
          <Border Grid.Row="1" Grid.Column="2" Margin="5,5,0,0" Background="#05080C" BorderBrush="#2D3949" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <Grid>
              <TextBlock Text="RESULT ZX" Foreground="{StaticResource MutedBrush}" Margin="9" Panel.ZIndex="1" />
              <ScrollViewer AutomationProperties.Name="Result ZX view" infra:ScrollSyncBehavior.Group="OrthogonalViews" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="16">
                <Image Source="{Binding ResultZxImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" infra:LegacyImageInteractionBehavior.IsEnabled="True" infra:LegacyImageInteractionBehavior.Plane="Zx" infra:LegacyImageInteractionBehavior.SelectLabels="True">
                  <Image.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" /></Image.LayoutTransform>
                </Image>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Display minimum" Foreground="{StaticResource MutedBrush}" />
            <Slider AutomationProperties.Name="Display minimum" Minimum="0" Maximum="0.99" Value="{Binding WindowMinimum}" SmallChange="0.01" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Display maximum" Foreground="{StaticResource MutedBrush}" />
            <Slider AutomationProperties.Name="Display maximum" Minimum="0.01" Maximum="1" Value="{Binding WindowMaximum}" SmallChange="0.01" />
          </StackPanel>
        </Grid>
      </Grid>

      <Border Grid.Column="2" Background="{StaticResource RaisedBrush}" BorderBrush="#283241" BorderThickness="1,0,0,0">
        <ScrollViewer AutomationProperties.Name="Processing and editing controls" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20">
            <StackPanel IsEnabled="{Binding IsIdle}">
            <TextBlock Text="OPERATION" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10" />
            <ComboBox AutomationProperties.Name="Operation" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" />
            <TextBlock Text="Backend" Margin="0,12,0,5" />
            <ComboBox AutomationProperties.Name="Backend" ItemsSource="{Binding Backends}" SelectedItem="{Binding Backend}" />

            <StackPanel Visibility="{Binding UsesThreshold, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="Threshold" Margin="0,12,0,5" />
              <Slider AutomationProperties.Name="Threshold" Minimum="0" Maximum="1" Value="{Binding Threshold}" SmallChange="0.01" />
              <TextBlock Text="{Binding Threshold, StringFormat=F3}" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>

            <StackPanel Visibility="{Binding UsesRadius, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="Radius" Margin="0,12,0,5" />
              <Slider AutomationProperties.Name="Radius" Minimum="{Binding MinimumRadius}" Maximum="{Binding MaximumRadius}" Value="{Binding Radius}" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock Text="{Binding Radius}" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsResampleZ, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Separator Margin="0,16,0,12" Background="#354152" />
              <TextBlock Text="Z RESAMPLING" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
              <TextBlock Text="Target Z spacing" Margin="0,10,0,5" />
              <TextBox AutomationProperties.Name="Target Z spacing" Text="{Binding TargetSpacingZ, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Defaults to the input X spacing so calibrated data becomes isotropic in X/Z." Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" />
              <StackPanel Visibility="{Binding IsLanczosResample, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Lanczos order" Margin="0,10,0,5" />
                <ComboBox AutomationProperties.Name="Lanczos order" ItemsSource="{Binding LanczosOrders}" SelectedItem="{Binding LanczosOrder}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding IsAdaptiveThreshold, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Separator Margin="0,16,0,12" Background="#354152" />
              <TextBlock Text="ADAPTIVE THRESHOLD" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
              <TextBlock Text="Local kernel" Margin="0,10,0,5" />
              <ComboBox AutomationProperties.Name="Adaptive threshold local kernel" ItemsSource="{Binding DsltKernels}" SelectedItem="{Binding AdaptiveThresholdKernel}" />
              <TextBlock Text="C offset (legacy scale)" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="Adaptive threshold C offset" Minimum="-100" Maximum="500" Value="{Binding AdaptiveThresholdOffset}" SmallChange="1" />
              <TextBlock Text="{Binding AdaptiveThresholdOffset, StringFormat=F1}" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="Core comparison: source &gt; local mean + 0.002 × offset" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsHMinima, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Separator Margin="0,16,0,12" Background="#354152" />
              <TextBlock Text="H-MINIMA" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
              <TextBlock Text="Height h" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="H-minima height" Minimum="0" Maximum="1" Value="{Binding HMinimaHeight}" SmallChange="0.01" />
              <TextBlock Text="{Binding HMinimaHeight, StringFormat=F3}" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="Convergence check interval" Margin="0,10,0,5" />
              <TextBox AutomationProperties.Name="H-minima convergence check interval" Text="{Binding HMinimaCheckInterval, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsHeightSurfaceOperation, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Separator Margin="0,16,0,12" Background="#354152" />
              <TextBlock Text="HEIGHT MAP" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
              <TextBlock Text="Filter type" Margin="0,10,0,5" />
              <ComboBox AutomationProperties.Name="Height map filter type" ItemsSource="{Binding DsltKernels}" SelectedItem="{Binding HeightMapKernel}" />
              <TextBlock Text="XY smoothing radius" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="Height map XY smoothing radius" Minimum="0" Maximum="64" Value="{Binding HeightMapXyRadius}" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock Text="{Binding HeightMapXyRadius}" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="Z filter radius" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="Height map Z filter radius" Minimum="0" Maximum="64" Value="{Binding HeightMapZRadius}" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock Text="{Binding HeightMapZRadius}" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="XY smoothing passes" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="Height map XY smoothing passes" Minimum="0" Maximum="10" Value="{Binding HeightMapSmoothLevel}" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock Text="{Binding HeightMapSmoothLevel}" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="The filtered surface is shared by height map, depth map, and height projection." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsHeightProjection, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Separator Margin="0,16,0,12" Background="#354152" />
              <TextBlock Text="HEIGHT PROJECTION" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
              <TextBlock Text="Sampling direction" Margin="0,10,0,5" />
              <ComboBox AutomationProperties.Name="Height projection sampling direction" ItemsSource="{Binding ProjectionModes}" SelectedItem="{Binding ProjectionMode}" />
              <TextBlock Text="Surface offset" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="Height projection surface offset" Minimum="{Binding MinimumProjectionDepth}" Maximum="{Binding MaximumProjectionDepth}" Value="{Binding ProjectionOffset}" SmallChange="0.25" />
              <TextBlock Text="{Binding ProjectionOffset, StringFormat=F2}" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="Start depth" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="Height projection start depth" Minimum="{Binding MinimumProjectionDepth}" Maximum="{Binding MaximumProjectionDepth}" Value="{Binding ProjectionStartDepth}" SmallChange="0.25" />
              <TextBlock Text="{Binding ProjectionStartDepth, StringFormat=F2}" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="Projection range" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="Height projection range" Minimum="0" Maximum="{Binding MaximumProjectionDepth}" Value="{Binding ProjectionRange}" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock Text="{Binding ProjectionRange}" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="Projection threshold" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="Height projection threshold" Minimum="0" Maximum="1" Value="{Binding ProjectionThreshold}" SmallChange="0.01" />
              <TextBlock Text="{Binding ProjectionThreshold, StringFormat=F3}" Foreground="{StaticResource AccentBrush}" />
              <CheckBox AutomationProperties.Name="Enable depth coloring" Content="Depth color (Z mode)" IsChecked="{Binding DepthColorEnabled}" IsEnabled="{Binding CanUseDepthColoring}" Margin="0,12,0,5" />
              <TextBlock Text="Depth color range" Margin="0,5,0,5" />
              <Slider AutomationProperties.Name="Depth color range" Minimum="1" Maximum="500" Value="{Binding DepthColorRange}" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding CanUseDepthColoring}" />
              <TextBlock Text="{Binding DepthColorRange}" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="Maps distance 0..range to HSV hue 0..270° while preserving projection intensity as brightness." Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsWatershed, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Separator Margin="0,16,0,12" Background="#354152" />
              <TextBlock Text="WATERSHED" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
              <TextBlock Text="Uses the current selected labels as seeds. Flooding is fixed to 256 normalized intensity levels and 6-neighbor legacy priority." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" />
              <TextBlock Text="Select one or more labels in the Edit stage before running." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsZGradient, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Separator Margin="0,16,0,12" Background="#354152" />
              <TextBlock Text="Z-GRADIENT CORRECTION" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
              <TextBlock Text="Depth coefficient" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="Z-gradient depth coefficient" Minimum="0" Maximum="10" Value="{Binding ZGradientCoefficient}" SmallChange="0.1" />
              <TextBlock Text="{Binding ZGradientCoefficient, StringFormat=F2}" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="Depth exponent" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="Z-gradient depth exponent" Minimum="1" Maximum="10" Value="{Binding ZGradientExponent}" SmallChange="0.1" />
              <TextBlock Text="{Binding ZGradientExponent, StringFormat=F2}" Foreground="{StaticResource AccentBrush}" />
              <CheckBox AutomationProperties.Name="Use filtered height map for Z-gradient correction" Content="Measure depth from filtered height map" IsChecked="{Binding ZGradientUseHeightMap}" Margin="0,12,0,5" />
              <TextBlock Text="Uses the display minimum/maximum above for the legacy range adjustment. When enabled, the height-map controls generate the surface first." Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsThresholdSweep, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Separator Margin="0,16,0,12" Background="#354152" />
              <TextBlock Text="THRESHOLD SWEEP" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
              <TextBlock Text="Minimum / maximum threshold" Margin="0,10,0,5" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBox AutomationProperties.Name="Minimum threshold" Text="{Binding MinimumThreshold, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox AutomationProperties.Name="Maximum threshold" Grid.Column="2" Text="{Binding MaximumThreshold, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
              <TextBlock Text="Threshold interval" Margin="0,10,0,5" />
              <TextBox AutomationProperties.Name="Threshold interval" Text="{Binding ThresholdInterval, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Closing radius" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="Threshold sweep closing radius" Minimum="0" Maximum="50" Value="{Binding ClosingRadius}" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock Text="{Binding ClosingRadius}" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="Minimum invalid-structure area" Margin="0,10,0,5" />
              <TextBox AutomationProperties.Name="Threshold sweep minimum invalid-structure area" Text="{Binding MinimumInvalidStructureArea, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsDsltOperation, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Separator Margin="0,16,0,12" Background="#354152" />
              <TextBlock Text="DSLT" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
              <TextBlock Text="Direction subdivision level" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="DSLT direction subdivision level" Minimum="1" Maximum="10" Value="{Binding DirectionLevel}" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock Text="{Binding DirectionLevel}" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="Line kernel" Margin="0,10,0,5" />
              <ComboBox AutomationProperties.Name="DSLT line kernel" ItemsSource="{Binding DsltKernels}" SelectedItem="{Binding DsltKernel}" />
              <TextBlock Text="Z correction factor" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="DSLT Z correction factor" Minimum="0" Maximum="1" Value="{Binding ZCorrectionFactor}" SmallChange="0.01" />
              <TextBlock Text="{Binding ZCorrectionFactor, StringFormat=F3}" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="Preview offset C (legacy scale)" Margin="0,10,0,5" />
              <Slider AutomationProperties.Name="DSLT preview offset C" Minimum="0" Maximum="200" Value="{Binding PreviewOffset}" SmallChange="1" />
              <TextBlock Text="{Binding PreviewOffset, StringFormat=F1}" Foreground="{StaticResource AccentBrush}" />

              <StackPanel Visibility="{Binding IsDsltSegmentation, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Core C minimum / maximum (capture pending)" Margin="0,12,0,5" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBox AutomationProperties.Name="DSLT core C minimum" Text="{Binding MinimumC, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBox AutomationProperties.Name="DSLT core C maximum" Grid.Column="2" Text="{Binding MaximumC, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <TextBlock Text="C interval" Margin="0,10,0,5" />
                <TextBox AutomationProperties.Name="DSLT C interval" Text="{Binding CInterval, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Closing radius" Margin="0,10,0,5" />
                <Slider AutomationProperties.Name="DSLT closing radius" Minimum="0" Maximum="50" Value="{Binding ClosingRadius}" TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock Text="{Binding ClosingRadius}" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Minimum invalid-structure area" Margin="0,10,0,5" />
                <TextBox AutomationProperties.Name="DSLT minimum invalid-structure area" Text="{Binding MinimumInvalidStructureArea, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>

              <Button Content="Calculate work estimate" Command="{Binding EstimateCommand}" Margin="0,14,0,0" Background="#39475A" Foreground="White" />
              <Border Padding="10" Background="#10161E" CornerRadius="5" Margin="0,4,0,0">
                <TextBlock Text="{Binding WorkEstimateSummary}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" />
              </Border>
            </StackPanel>

            <TextBlock Text="Connectivity" Margin="0,14,0,5" />
            <ComboBox AutomationProperties.Name="Connectivity" ItemsSource="{Binding Connectivities}" SelectedItem="{Binding Connectivity}" />
            <TextBlock Text="{Binding MinimumComponentSizeLabel}" Margin="0,10,0,5" />
            <TextBox AutomationProperties.Name="Minimum component size" Text="{Binding MinimumComponentSize, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Separator Margin="0,16,0,12" Background="#354152" />
              <TextBlock Text="LABEL EDITING" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" Margin="0,8,0,8" Foreground="{StaticResource MutedBrush}" />
              <TextBlock Text="{Binding ResultGeometrySummary}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}" />
              <TextBlock Text="Minimum displayed segment size (strict)" Margin="0,0,0,5" />
              <Slider AutomationProperties.Name="Minimum displayed segment size" Minimum="0" Maximum="100000" Value="{Binding MinimumDisplayedSegmentSize}" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock Text="{Binding MinimumDisplayedSegmentSize}" Foreground="{StaticResource AccentBrush}" />
              <CheckBox Content="Add cursor label to selection" IsChecked="{Binding AddToSelection}" Margin="0,0,0,8" />
              <WrapPanel>
                <Button Content="Select at cursor" Command="{Binding SelectAtCursorCommand}" />
                <Button Content="Select all" Command="{Binding SelectAllCommand}" />
                <Button Content="Clear" Command="{Binding ClearSelectionCommand}" Background="#39475A" Foreground="White" />
              </WrapPanel>
              <TextBlock Text="Active-channel mean threshold" Margin="0,8,0,5" />
              <Slider AutomationProperties.Name="Segment mean intensity threshold" Minimum="0" Maximum="1" Value="{Binding SelectionThreshold}" SmallChange="0.01" />
              <TextBlock Text="{Binding SelectionThreshold, StringFormat=F2}" Foreground="{StaticResource AccentBrush}" />
              <CheckBox Content="Deselect labels above threshold" IsChecked="{Binding DeselectAboveThreshold}" />
              <Button Content="Apply intensity selection" Command="{Binding SelectByMeanIntensityCommand}" Background="#39475A" Foreground="White" />
              <TextBlock Text="Morphology iterations" Margin="0,6,0,5" />
              <Slider AutomationProperties.Name="Label editing morphology iterations" Minimum="1" Maximum="64" Value="{Binding EditIterations}" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock Text="{Binding EditIterations}" Foreground="{StaticResource AccentBrush}" />
              <CheckBox Content="Clamp erosion at image edges" IsChecked="{Binding EditClampImageEdges}" Margin="0,4,0,0" />
              <WrapPanel Margin="0,8,0,0">
                <Button Content="Merge" Command="{Binding MergeSelectionCommand}" />
                <Button Content="Split" Command="{Binding SplitSelectionCommand}" />
                <Button Content="Dilate" Command="{Binding DilateSelectionCommand}" />
                <Button Content="Erode" Command="{Binding ErodeSelectionCommand}" />
                <Button Content="Crop" Command="{Binding CropSelectionCommand}" />
                <Button Content="Undo" Command="{Binding UndoEditCommand}" Background="#39475A" Foreground="White" />
              </WrapPanel>
            </StackPanel>
            </StackPanel>

            <ProgressBar AutomationProperties.Name="Operation progress" Height="7" Margin="0,20,0,12" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
            <WrapPanel>
              <Button Content="Run" Command="{Binding RunCommand}" MinWidth="100" />
              <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="100" Background="#39475A" Foreground="White" />
            </WrapPanel>
            <Border Padding="10" Background="#10161E" CornerRadius="5" Margin="0,8,0,4">
              <StackPanel>
                <TextBlock Text="PROCESSING CHAIN" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProcessingChainSummary}" TextWrapping="Wrap" Margin="0,5,0,8" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <WrapPanel>
                  <Button AutomationProperties.Name="Use result as processing input" Content="Use result as input" Command="{Binding UseResultAsInputCommand}" />
                  <Button AutomationProperties.Name="Reset processing chain" Content="Reset to loaded input" Command="{Binding ResetProcessingChainCommand}" Background="#39475A" Foreground="White" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Button Content="Export result + provenance" Command="{Binding SaveCommand}" Margin="0,4,0,0" Background="#39475A" Foreground="White" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#080C11" BorderBrush="#283241" BorderThickness="0,1,0,0">
      <Grid Margin="18,0">
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="#C8D2DE" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="Synthetic-data validated" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
